{
  "expo": {
    "name": "Atlas Vault",
    "slug": "atlas-vault",
    "version": "0.1.0-rc.1",
    "scheme": "atlasvault",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      "expo-build-properties"
    ]
  }
}
